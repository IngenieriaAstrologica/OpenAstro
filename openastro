            path = path + '<line x1="'+str(x1)+'" y1="'+str(y1)+'" x2="'+str(x2)+'" y2="'+str(y2)+'" style="stroke: #000000; stroke-width: 1px; stroke-dasharray:3,2; stroke-opacity:.4;"/>\n'

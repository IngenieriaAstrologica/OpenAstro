    def utcToLocal(self):
        #make local time variables from global UTC
        h, m, s = self.decHour(self.hour)
        utc = datetime.datetime(self.year, self.month, self.day, h, m, s)
        tz = datetime.timedelta(seconds=float(self.timezone)*float(3600))
        loc = utc + tz
        self.year_loc = loc.year
        self.month_loc = loc.month
        self.day_loc = loc.day
        self.hour_loc = loc.hour
        self.minute_loc = loc.minute
        self.second_loc = loc.second
        #print some info
        dprint('utcToLocal: '+str(utc)+' => '+str(loc)+self.decTzStr(self.timezone))
    
    def localToSolar(self, newyear):
        solaryearsecs = 31556925.51 # 365 days, 5 hours, 48 minutes, 45.51 seconds
        dprint("localToSolar: from %s to %s" %(self.year,newyear))
        h,m,s = self.decHour(self.hour)
        dt_original = datetime.datetime(self.year,self.month,self.day,h,m,s)
        dt_new = datetime.datetime(newyear,self.month,self.day,h,m,s)
        dprint("localToSolar: first sun %s" % (self.planets_degree_ut[0]) )
        mdata = ephemeris.ephData(newyear,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
        dprint("localToSolar: second sun %s" % (mdata.planets_degree_ut[0]) )
        sundiff = self.planets_degree_ut[0] - mdata.planets_degree_ut[0]
        dprint("localToSolar: sundiff %s" %(sundiff))
        sundelta = ( sundiff / 360.0 ) * solaryearsecs
        dprint("localToSolar: sundelta %s" % (sundelta))
        dt_delta = datetime.timedelta(seconds=int(sundelta))
        dt_new = dt_new + dt_delta
        mdata = ephemeris.ephData(dt_new.year,dt_new.month,dt_new.day,self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
        dprint("localToSolar: new sun %s" % (mdata.planets_degree_ut[0]))
        
        #get precise
        step = 0.000011408 # 1 seconds in degrees
        sundiff = self.planets_degree_ut[0] - mdata.planets_degree_ut[0]
        sundelta = sundiff / step
        dt_delta = datetime.timedelta(seconds=int(sundelta))
        dt_new = dt_new + dt_delta
        mdata = ephemeris.ephData(dt_new.year,dt_new.month,dt_new.day,self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
        dprint("localToSolar: new sun #2 %s" % (mdata.planets_degree_ut[0]))

        step = 0.000000011408 # 1 milli seconds in degrees
        sundiff = self.planets_degree_ut[0] - mdata.planets_degree_ut[0]
        sundelta = sundiff / step
        dt_delta = datetime.timedelta(milliseconds=int(sundelta))
        dt_new = dt_new + dt_delta
        mdata = ephemeris.ephData(dt_new.year,dt_new.month,dt_new.day,self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
        dprint("localToSolar: new sun #3 %s" % (mdata.planets_degree_ut[0]))    
        
        self.s_year = dt_new.year
        self.s_month = dt_new.month
        self.s_day = dt_new.day
        self.s_hour = self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second)
        self.s_geolon = self.geolon
        self.s_geolat = self.geolat
        self.s_altitude = self.altitude
        #show the solar return as a bi-wheel (natal inside, return outside) by
        #reusing the transit ring; the natal chart stays in self.* and the
        #return is copied into self.t_* as the outer wheel
        self.t_year = self.s_year
        self.t_month = self.s_month
        self.t_day = self.s_day
        self.t_hour = self.s_hour
        self.t_geolon = self.s_geolon
        self.t_geolat = self.s_geolat
        self.t_altitude = self.s_altitude
        self.solar_active = True
        self.biwheel_single = "Solar"
        self.type = "Transit"
        openAstro.charttype="%s (%s-%02d-%02d %02d:%02d:%02d UTC)" % (openAstro.label["solar"],self.s_year,self.s_month,self.s_day,dt_new.hour,dt_new.minute,dt_new.second)
        openAstro.transit=True
        return

    def localToLunar(self, year, month):
        #tropical month in seconds (Moon back to its natal longitude)
        lunarmonthsecs = 27.321661 * 86400.0
        dprint("localToLunar: from %s-%s-%s to %s-%02d" % (self.year,self.month,self.day,year,month))
        h,m,s = self.decHour(self.hour)
        #start mid-month at natal hour: converges to the return nearest
        #mid-month (returns recur every ~27.3 days, so exactly one is near)
        dt_new = datetime.datetime(year, month, 15, h, m, s)
        mdata = ephemeris.ephData(dt_new.year,dt_new.month,dt_new.day,self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
        #NOTE: geocentric Moon, never topocentric: lunar parallax reaches
        #almost a degree and would eat any tight orb (measured doctrine).
        moondiff = (self.planets_degree_ut[1] - mdata.planets_degree_ut[1] + 180.0) % 360.0 - 180.0
        dt_new = dt_new + datetime.timedelta(seconds=(moondiff / 360.0) * lunarmonthsecs)
        #refine with measured lunar speed (two-point, 3 passes: seconds precision)
        for k in range(3):
            m1 = ephemeris.ephData(dt_new.year,dt_new.month,dt_new.day,self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
            dt_plus = dt_new + datetime.timedelta(hours=1)
            m2 = ephemeris.ephData(dt_plus.year,dt_plus.month,dt_plus.day,self.decHourJoin(dt_plus.hour,dt_plus.minute,dt_plus.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
            speed = ((m2.planets_degree_ut[1] - m1.planets_degree_ut[1] + 180.0) % 360.0 - 180.0) / 3600.0
            if abs(speed) < 1e-9:
                break
            diff = (self.planets_degree_ut[1] - m1.planets_degree_ut[1] + 180.0) % 360.0 - 180.0
            dt_new = dt_new + datetime.timedelta(seconds=diff / speed)
        mdata = ephemeris.ephData(dt_new.year,dt_new.month,dt_new.day,self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second),self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
        dprint("localToLunar: natal moon %s return moon %s" % (self.planets_degree_ut[1], mdata.planets_degree_ut[1]))

        self.l_year = dt_new.year
        self.l_month = dt_new.month
        self.l_day = dt_new.day
        self.l_hour = self.decHourJoin(dt_new.hour,dt_new.minute,dt_new.second)
        self.l_geolon = self.geolon
        self.l_geolat = self.geolat
        self.l_altitude = self.altitude
        #show the lunar return as a bi-wheel (natal inside, return outside)
        #exactly like the solar return: natal stays in self.*, return goes
        #into self.t_* as the outer wheel
        self.t_year = self.l_year
        self.t_month = self.l_month
        self.t_day = self.l_day
        self.t_hour = self.l_hour
        self.t_geolon = self.l_geolon
        self.t_geolat = self.l_geolat
        self.t_altitude = self.l_altitude
        self.solar_active = True
        self.biwheel_single = "Lunar"
        self.type = "Transit"
        openAstro.charttype="%s (%s-%02d-%02d %02d:%02d:%02d UTC)" % (_("Lunar Return"),self.l_year,self.l_month,self.l_day,dt_new.hour,dt_new.minute,dt_new.second)
        openAstro.transit=True
        return
        
    def localToSecondaryProgression(self,dt):
        

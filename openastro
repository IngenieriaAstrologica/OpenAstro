        self.atgrid=[]
        #ascensional transits (mundo contacts) apply to the transit
        #bi-wheel only (Transit Chart / Synastry share biwheel_single
        #"TransitOuter"); solar, progressed, directed and dodecatemoria
        #bi-wheels keep their own logic. The wheels stay ecliptic: each
        #contact uses its own transit pole, so no single OA wheel exists.
        measure = getattr(self, 'transit_measure', 'ecliptic')
        if measure not in primary_engine.TRANSIT_MEASURE_KEYS:
            measure = 'ecliptic'
        asc = (measure == 'ascensional' and getattr(self, 'solar_active', False)
            and getattr(self, 'biwheel_single', '') == "TransitOuter")
        if asc:
            natal_lat = list(getattr(self, 'planets_latitude', []))
            transit_lat = list(getattr(self, 't_planets_latitude', []))
            ramc_t = float(getattr(self, 't_ramc', getattr(self, 'ramc', 0.0)))
            jd_n = float(getattr(self, 'birth_jd', 0.0))
            jd_t = float(getattr(self, 't_jd', jd_n))
            geo_lat = float(self.geolat)
        for i in range(len(self.planets)):
            start=self.planets_degree_ut[i]
            for x in range(i+1):
                end=self.t_planets_degree_ut[x]
                if asc:
                    #OA equality under the transiting planet's own
                    #topocentric pole, both bodies with true latitude
                    nlat = natal_lat[i] if i < len(natal_lat) else 0.0
                    tlat = transit_lat[x] if x < len(transit_lat) else 0.0
                    try:
                        oa_n, oa_t, _pole = primary_engine.transit_oa_pair(
                            self.planets_degree_ut[i], nlat,
                            self.t_planets_degree_ut[x], tlat,
                            geo_lat, ramc_t, jd_n, jd_t)
                        diff=float(self.degreeDiff(oa_n,oa_t))
                    except Exception:
                        diff=float(self.degreeDiff(start,end))
                else:
                    diff=float(self.degreeDiff(start,end))
                #loop orbs
                if (self.planets[i]['visible'] == 1) & (self.planets[x]['visible'] == 1):   
                    for z in range(len(self.aspects)):
                        #check for personal planets and determine orb
                        if 0 <= i <= 4 or 0 <= x <= 4:
                            orb_before = 1.0
                        else:
                            orb_before = 2.0
                        #check if we want to display this aspect    
                        if  ( float(self.aspects[z]['degree']) - orb_before ) <= diff <= ( float(self.aspects[z]['degree']) + 1.0 ):
                            if self.aspects[z]['visible'] == 1:
                                out = out + self.drawAspect( r , ar , self.planets_degree_ut[i] , self.t_planets_degree_ut[x] , self.colors["aspect_%s" %(self.aspects[z]['degree'])] )     
                            #aspect grid dictionary
                            if self.aspects[z]['visible_grid'] == 1:
                                self.atgrid.append({})
                                self.atgrid[-1]['p1']=i
                                self.atgrid[-1]['p2']=x
                                self.atgrid[-1]['aid']=z
                                self.atgrid[-1]['diff']=diff
                                if getattr(self, 'biwheel_single', '') == "Directed" and getattr(self, 'solar_active', False):
                                    #directed grid shows the ARC orb in DMS plus
                                    #applicative/separative (rectificacion report
                                    #style) instead of the aspect degree. sig =
                                    #outer directed body, pro = inner natal body;
                                    #delta = needed_arc - elapsed_arc, orb = |delta|.
                                    arc_now = float(getattr(self, 'directed_arc', 0.0))
                                    converse = bool(getattr(self, 'directed_converse', False))
                                    alpha = float(self.aspects[z]['degree'])
                                    if getattr(self, 'directed_measure', 'ecl_ecl') == "asc_asc":
                                        #OA aspects: perfection arc is linear in
                                        #OA space, both rays tried
                                        signed = (self.t_planets_degree_ut[x] - self.planets_degree_ut[i] + 180.0) % 360.0 - 180.0
                                        best = None
                                        for s in (1.0, -1.0):
                                            orb = (s * alpha - signed + 180.0) % 360.0 - 180.0
                                            if best is None or abs(orb) < abs(best):
                                                best = orb
                                        delta = best
                                    else:
                                        #zodiacal aspects: exact arc per ray under
                                        #the significator's pole, closest to now wins
                                        sig_lon = self.planets_degree_ut[x]
                                        sig_lat = self.planets_latitude[x] if x < len(self.planets_latitude) else 0.0
                                        pro_lon = self.planets_degree_ut[i]
                                        rays = (0.0,) if alpha in (0.0, 180.0) else (alpha, -alpha)
                                        best = None
                                        for ray in rays:
                                            exact = primary_engine.arc_of_direction(sig_lon, sig_lat, pro_lon, 0.0, ray, self.geolat, self.ramc, self.birth_jd)
                                            delta = (exact - arc_now + 180.0) % 360.0 - 180.0
                                            if best is None or abs(delta) < abs(best):
                                                best = delta
                                        delta = best
                                    self.atgrid[-1]['arc_orb'] = abs(delta)
                                    self.atgrid[-1]['applicative'] = (delta < 0) if converse else (delta > 0)
        return out


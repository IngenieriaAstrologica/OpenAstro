    def specialTransitSubmit(self, widget, entry):
        measure = self.transit_measure_list[entry.get_active()]
        if measure not in primary_engine.TRANSIT_MEASURE_KEYS:
            measure = "ecliptic"
        #remember last used measure in astrocfg for the next run
        db.setAstrocfg('transit_measure', measure)
        openAstro.transit_measure = measure
        self.win_ST.destroy()
        openAstro.type="Transit"
        #Transit Chart is a bi-wheel (natal inside, transit outside),
        #so enable Chart View; "Outer only" renders the transit
        #moment alone via the TransitOuter type
        openAstro.solar_active=True
        openAstro.biwheel_single="TransitOuter"
        openAstro.t_geolon=float(openAstro.home_geolon)
        openAstro.t_geolat=float(openAstro.home_geolat)

        now = datetime.datetime.now()
        timezone_str = zonetab.nearest_tz(openAstro.t_geolat,openAstro.t_geolon,zonetab.timezones())[2]
        #aware datetime object
        dt_input = datetime.datetime(now.year, now.month, now.day, now.hour, now.minute, now.second)
        dt = dt_input.replace(tzinfo=ZoneInfo(timezone_str), fold=1)
        #naive utc datetime object
        dt_utc = dt.replace(tzinfo=None) - dt.utcoffset()
        #transit data
        openAstro.t_year=dt_utc.year
        openAstro.t_month=dt_utc.month
        openAstro.t_day=dt_utc.day
        openAstro.t_hour=openAstro.decHourJoin(dt_utc.hour,dt_utc.minute,dt_utc.second)
        openAstro.t_timezone=openAstro.offsetToTz(dt.utcoffset())
        openAstro.t_altitude=25

        #make svg with transit
        measure_tag = primary_engine.TRANSIT_MEASURE_TAGS[measure]
        openAstro.charttype="%s (%s-%02d-%02d %02d:%02d%s)" % (openAstro.label["transit"],dt.year,dt.month,dt.day,dt.hour,dt.minute,measure_tag)
        openAstro.transit=True
        #a fresh transit chart defaults to the bi-wheel view
        self._resetChartViewBoth()
        openAstro.makeSVG()
        self.draw.queue_draw()
        self.draw.setSVG(self.tempfilename) 


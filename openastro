                path = path + '<polygon points="%s,%s %s,%s %s,%s" style="fill: #000000;"/>\n' % (
                    x2, y2, bx + px * W / 2, by + py * W / 2, bx - px * W / 2, by - py * W / 2)
                        
        return path
    

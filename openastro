def _rsvg_render(handle, cr):
    """Render a whole SVG handle at its natural size onto a Cairo context,
    using the modern Rsvg.Handle.render_document() API."""
    viewport = Rsvg.Rectangle()
    viewport.x = 0.0
    viewport.y = 0.0
    viewport.width = float(handle.props.width)
    viewport.height = float(handle.props.height)
    handle.render_document(cr, viewport)


#cairo svg class
class drawSVG(Gtk.DrawingArea):
    def __init__(self,fit=False):
        super().__init__()
        self.svg = None
        #fit=True scales the drawing to the widget instead of to the screen,
        #so the chart follows the window size (tables keep their own size)
        self.fit = fit
        self.connect("draw", self.exposeEvent)
        self.connect("size-allocate", lambda w,a: w.queue_draw())

    def setSVG(self,svg):
        self.svg = Rsvg.Handle.new_from_file(svg)
        self.svg.set_dpi(400)
        width=self.svg.props.width*openAstro.zoom
        height=self.svg.props.height*openAstro.zoom
        if self.fit:
            #only claim scrolling room when zoomed in, otherwise follow the window
            if openAstro.zoom > 1:
                self.set_size_request(int(width),int(height))
            else:
                self.set_size_request(-1,-1)
        else:
            self.set_size_request(int(width),int(height))
        self.queue_draw()
        dprint('drawSVG.setSVG file %s' % (svg))

    def exposeEvent(self,widget,event):
        #try:
        #   context = self.get_window().cairo_create()
        #except AttributeError as err:
        #   print(err)
        #   return True

        if self.svg == None:
            return False

        nat_w = float(self.svg.props.width)
        nat_h = float(self.svg.props.height)
        if not self.fit or nat_w <= 0 or nat_h <= 0:
            _rsvg_render(self.svg, event)
            return False

        #the template already applies the zoom itself (scale($cfgZoom) around
        #its top left corner), so only the unzoomed chart is scaled here
        alloc = self.get_allocation()
        zoom = openAstro.zoom
        if zoom > 1:
            #setSVG made room for the zoomed chart at its natural size
            scale = 1.0
        else:
            #fit the chart to the allocation, keeping the aspect ratio
            scale = min(alloc.width/nat_w, alloc.height/nat_h)
        #center what is actually drawn: the chart at scale*zoom
        width, height = nat_w*scale*zoom, nat_h*scale*zoom
        event.save()
        event.translate(max(0.0, (alloc.width-width)/2.0), max(0.0, (alloc.height-height)/2.0))
        event.scale(scale, scale)
        _rsvg_render(self.svg, event)
        event.restore()
        return False


    def localToDodecatemoria(self):
        #Dodecatemorias (Morinus antiscia.calcDodecatemoria) como rueda exterior:
        #el radix se mantiene en self.* (rueda interior) y las dodecatemorias
        #de cada posicion natal se copian en self.t_* (rueda exterior),
        #reutilizando el anillo de transitos. No requiere fecha nueva:
        #deriva integramente del radix (dodec = 30*signo + 12*lon_relativa).
        try:
            natal_ut = list(self.planets_degree_ut)
            natal_houses_ut = list(self.houses_degree_ut)
            natal_retro = list(self.planets_retrograde)
        except AttributeError:
            planets = getattr(self, 'planets', None) or db.getSettingsPlanet()
            self.planets = planets
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
            natal_ut = list(module_data.planets_degree_ut)
            natal_houses_ut = list(module_data.houses_degree_ut)
            natal_retro = list(module_data.planets_retrograde)

        dodec_ut = [ephemeris.calc_dodecatemoria(v) for v in natal_ut]
        dodec_houses_ut = [ephemeris.calc_dodecatemoria(v) for v in natal_houses_ut]

        #rueda exterior = dodecatemorias (grado_en_signo para las etiquetas)
        self.t_planets_degree_ut = dodec_ut
        self.t_planets_sign = [int(v // 30.0) % 12 for v in dodec_ut]
        self.t_planets_degree = [v - s * 30.0 for v, s in zip(dodec_ut, self.t_planets_sign)]
        self.t_planets_retrograde = natal_retro
        self.t_houses_degree_ut = dodec_houses_ut
        self.t_houses_sign = [int(v // 30.0) % 12 for v in dodec_houses_ut]
        self.t_houses_degree = [v - s * 30.0 for v, s in zip(dodec_houses_ut, self.t_houses_sign)]
        #referencia temporal/geografica = radix (no es un momento real)
        self.t_year = self.year
        self.t_month = self.month
        self.t_day = self.day
        self.t_hour = self.hour
        self.t_geolon = self.geolon
        self.t_geolat = self.geolat
        self.t_altitude = self.altitude
        self.solar_active = True
        self.biwheel_single = "Dodecatemoria"
        self.type = "Transit"
        openAstro.charttype="%s (%s)" % (_("Dodecatemoria"), openAstro.name)
        openAstro.transit=True
        return

    def localToAntiscia(self, contra=False):
        #Antiscia (Morinus antiscia.calc) como rueda exterior: el radix se
        #mantiene en self.* (rueda interior) y los antiscios —o los
        #contraantiscios si contra=True— de cada posicion natal se copian
        #en self.t_* (rueda exterior), reutilizando el anillo de transitos.
        #No requiere fecha nueva: deriva integramente del radix (reflejo
        #sobre el eje Cancer 0 / Capricornio 0).
        try:
            natal_ut = list(self.planets_degree_ut)
            natal_houses_ut = list(self.houses_degree_ut)
            natal_retro = list(self.planets_retrograde)
            ayan = float(self.ayanamsa)
        except AttributeError:
            planets = getattr(self, 'planets', None) or db.getSettingsPlanet()
            self.planets = planets
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
            natal_ut = list(module_data.planets_degree_ut)
            natal_houses_ut = list(module_data.houses_degree_ut)
            natal_retro = list(module_data.planets_retrograde)
            ayan = float(getattr(module_data, 'ayanamsa', 0.0))

        ant = [ephemeris.calc_antiscion(v, ayan) for v in natal_ut]
        ant_houses = [ephemeris.calc_antiscion(v, ayan) for v in natal_houses_ut]
        self.antiscia_contra = contra
        outer_ut = [c for a, c in ant] if contra else [a for a, c in ant]
        outer_houses_ut = [c for a, c in ant_houses] if contra else [a for a, c in ant_houses]

        #rueda exterior = antiscios o contraantiscios (grado_en_signo
        #para las etiquetas)
        self.t_planets_degree_ut = outer_ut
        self.t_planets_sign = [int(v // 30.0) % 12 for v in self.t_planets_degree_ut]
        self.t_planets_degree = [v - s * 30.0 for v, s in zip(self.t_planets_degree_ut, self.t_planets_sign)]
        self.t_planets_retrograde = natal_retro
        self.t_houses_degree_ut = outer_houses_ut
        self.t_houses_sign = [int(v // 30.0) % 12 for v in self.t_houses_degree_ut]
        self.t_houses_degree = [v - s * 30.0 for v, s in zip(self.t_houses_degree_ut, self.t_houses_sign)]
        #referencia temporal/geografica = radix (no es un momento real)
        self.t_year = self.year
        self.t_month = self.month
        self.t_day = self.day
        self.t_hour = self.hour
        self.t_geolon = self.geolon
        self.t_geolat = self.geolat
        self.t_altitude = self.altitude
        self.solar_active = True
        self.biwheel_single = "Antiscia"
        self.type = "Transit"
        openAstro.charttype="%s (%s)" % (_("Contraantiscia") if contra else _("Antiscia"), openAstro.name)
        openAstro.transit=True
        return

    def localToDirected(self, dt, key="naibod", converse=False, measure="ecl_ecl"):
        #Direcciones primarias topocentricas (sistema Polich-Page, motor
        #openastromod.primary) como rueda exterior: el radix se mantiene en
        #self.* (rueda interior) y las posiciones dirigidas por el arco que
        #corresponde a la fecha pedida se copian en self.t_* (rueda exterior),
        #reutilizando el anillo de transitos. Se dirigen los cuerpos visibles
        #y las cuspides, cada uno bajo su propio polo topocentrico.
        #converse=True niega el arco (direcciones conversas, hacia el pasado).
        #measure: ecl_ecl (carta ecliptica), asc_asc (carta ascensional) o
        #asc_ecl (mixta: rueda natal ecliptica con primarias superpuestas).
        if key not in primary_engine.TIME_KEYS:
            key = "naibod"
        if measure not in primary_engine.MEASURE_KEYS:
            measure = "ecl_ecl"

        #remove timezone (same as secondary progressions: dt comes in local time)
        dt_utc = dt - datetime.timedelta(seconds=float(self.timezone)*float(3600))

        #fresh natal frame (guarantees latitudes, RAMC and birth JD)
        if getattr(self, 'planets', None) is None:
            self.planets = db.getSettingsPlanet()
        natal = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)

        target_jd = primary_engine.julday(dt_utc.year,dt_utc.month,dt_utc.day,self.decHourJoin(dt_utc.hour,dt_utc.minute,dt_utc.second))
        arc = primary_engine.arc_for_dates(natal.jd_ut, target_jd, key)
        if converse:
            arc = -arc
        self.directed_arc = arc
        self.directed_key = key
        self.directed_converse = converse
        self.directed_measure = measure

        #outer wheel = directed positions (degree-in-sign for the labels).
        #Ascensional measure renders OA values; the ecliptic measures render
        #Marr-directed ecliptic longitudes (same outer in both: the mixed
        #overlay only differs from the ecliptic chart in presentation).
        if measure == "asc_asc":
            oa_nat, dp, f_nat, dh = primary_engine.oa_positions(natal.planets_degree_ut, natal.planets_latitude, natal.houses_degree_ut[0], arc, self.geolat, natal.ramc, natal.jd_ut)
        else:
            dp, dh = primary_engine.direct_frame(natal.planets_degree_ut, natal.planets_latitude, natal.houses_degree_ut, arc, self.geolat, natal.ramc, natal.jd_ut)
        self.t_planets_degree_ut = dp
        self.t_planets_sign = [int(v // 30.0) % 12 for v in dp]
        self.t_planets_degree = [v - s * 30.0 for v, s in zip(dp, self.t_planets_sign)]
        self.t_planets_retrograde = list(natal.planets_retrograde)
        self.t_houses_degree_ut = dh
        self.t_houses_sign = [int(v // 30.0) % 12 for v in dh]
        self.t_houses_degree = [v - s * 30.0 for v, s in zip(dh, self.t_houses_sign)]
        #reference date = requested date at the natal place (derived chart)
        self.t_year = dt_utc.year
        self.t_month = dt_utc.month
        self.t_day = dt_utc.day
        self.t_hour = self.decHourJoin(dt_utc.hour,dt_utc.minute,dt_utc.second)
        self.t_geolon = self.geolon
        self.t_geolat = self.geolat
        self.t_altitude = self.altitude
        self.solar_active = True
        self.biwheel_single = "Directed"
        self.type = "Transit"
        direction = _(", converse") if converse else ""
        measure_tag = primary_engine.MEASURE_TAGS[measure]
        openAstro.charttype="%s (%s-%02d-%02d, %s%s%s)" % (_("Primary Directions"),dt.year,dt.month,dt.day,key,measure_tag,direction)
        openAstro.transit=True
        return

    def split_sign_degree(self, values):
        #helper: full longitudes -> (signs, in-sign degrees) for the labels
        signs = [int(v // 30.0) % 12 for v in values]
        return signs, [v - s * 30.0 for v, s in zip(values, signs)]
    
    def makeSVG( self , printing=None ):
        #empty element points
        self.fire=0.0
        self.earth=0.0
        self.air=0.0
        self.water=0.0
            
        #get database planet settings   
        self.planets = db.getSettingsPlanet()
        
        #get database aspect settings
        self.aspects = db.getSettingsAspect()
        
        #Combine module data
        if self.type == "Combine":
            #make calculations
            module_data = ephemeris.ephData(self.c_year,self.c_month,self.c_day,self.c_hour,self.c_geolon,self.c_geolat,self.c_altitude,self.planets,self.zodiac,db.astrocfg)
        
        #Solar module data
        if self.type == "Solar":
            module_data = ephemeris.ephData(self.s_year,self.s_month,self.s_day,self.s_hour,self.s_geolon,self.s_geolat,self.s_altitude,self.planets,self.zodiac,db.astrocfg)
        
        elif self.type == "SecondaryProgression":
            module_data = ephemeris.ephData(self.sp_year,self.sp_month,self.sp_day,self.sp_hour,self.sp_geolon,self.sp_geolat,self.sp_altitude,self.planets,self.zodiac,db.astrocfg,houses_override=self.houses_override)               
            
        elif self.type == "TransitOuter":
            #single-wheel view of the outer chart only ("Outer only" for
            #Transit Chart / Synastry): render the t_* moment on its own
            #with its own houses, like a Radix of that moment
            module_data = ephemeris.ephData(self.t_year,self.t_month,self.t_day,self.t_hour,self.t_geolon,self.t_geolat,self.t_altitude,self.planets,self.zodiac,db.astrocfg)

        elif self.type == "Lunar":
            #single-wheel view of the lunar return ("Outer only" for the
            #Lunar Return chart): the return moment on its own
            module_data = ephemeris.ephData(self.l_year,self.l_month,self.l_day,self.l_hour,self.l_geolon,self.l_geolat,self.l_altitude,self.planets,self.zodiac,db.astrocfg)

        elif self.type == "Dodecatemoria":
            #single-wheel view of the dodecatemoria positions ("Outer only"
            #for the Dodecatemoria chart): natal houses as frame, planets
            #at their dodecatemoria longitudes (see override below)
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)

        elif self.type == "Antiscia":
            #single-wheel view of the antiscion positions ("Outer only"
            #for the Antiscia chart): natal houses as frame, planets
            #at their antiscion longitudes (see override below)
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)

        elif self.type == "Directed":
            #single-wheel view of the directed positions ("Outer only"
            #for the Primary Directions chart): directed houses as frame,
            #planets at their directed longitudes (see override below)
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)

        elif self.type == "Transit" or self.type == "Composite":
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)
            t_module_data = ephemeris.ephData(self.t_year,self.t_month,self.t_day,self.t_hour,self.t_geolon,self.t_geolat,self.t_altitude,self.planets,self.zodiac,db.astrocfg)
        
        else:
            #make calculations
            module_data = ephemeris.ephData(self.year,self.month,self.day,self.hour,self.geolon,self.geolat,self.altitude,self.planets,self.zodiac,db.astrocfg)

        #Transit module data
        if self.type == "Transit" or self.type == "Composite":
            #grab transiting module data
            self.t_planets_sign = t_module_data.planets_sign
            self.t_planets_degree = t_module_data.planets_degree
            self.t_planets_degree_ut = t_module_data.planets_degree_ut
            self.t_planets_retrograde = t_module_data.planets_retrograde
            self.t_planets_speed = list(getattr(t_module_data, 'planets_speed', [0.0] * len(self.t_planets_degree_ut)))
            self.t_planets_stationary = list(getattr(t_module_data, 'planets_stationary', [False] * len(self.t_planets_degree_ut)))
            self.t_houses_degree = t_module_data.houses_degree
            self.t_houses_sign = t_module_data.houses_sign
            self.t_houses_degree_ut = t_module_data.houses_degree_ut
            #extra transit frame for ascensional transits
            #(openastromod.primary.transit_oa_pair): real latitudes,
            #transit RAMC and transit JD; natal frame (latitudes, RAMC,
            #birth JD) is grabbed below as for primary directions
            self.t_planets_latitude = list(getattr(t_module_data, 'planets_latitude', [0.0] * len(self.t_planets_degree_ut)))
            self.t_ramc = float(getattr(t_module_data, 'ramc', 0.0)) % 360.0
            self.t_jd = float(getattr(t_module_data, 'jd_ut', 0.0))

        #grab normal module data
        self.planets_sign = module_data.planets_sign
        self.planets_degree = module_data.planets_degree
        self.planets_degree_ut = module_data.planets_degree_ut
        self.planets_retrograde = module_data.planets_retrograde
        self.planets_speed = list(getattr(module_data, 'planets_speed', [0.0] * len(self.planets_degree_ut)))
        self.planets_stationary = list(getattr(module_data, 'planets_stationary', [False] * len(self.planets_degree_ut)))
        self.houses_degree = module_data.houses_degree
        self.houses_sign = module_data.houses_sign
        self.houses_degree_ut = module_data.houses_degree_ut
        self.lunar_phase = module_data.lunar_phase
        #fixed stars (Morinus fixstars.py)
        self.fixed_names = list(getattr(module_data, 'fixed_names', []))
        self.fixed_short = list(getattr(module_data, 'fixed_short', []))
        self.fixed_degree_ut = list(getattr(module_data, 'fixed_degree_ut', []))
        self.fixed_latitude = list(getattr(module_data, 'fixed_latitude', []))
        self.fixed_sign = list(getattr(module_data, 'fixed_sign', []))
        self.fixed_degree = list(getattr(module_data, 'fixed_degree', []))
        self.fixed_orb = list(getattr(module_data, 'fixed_orb', []))
        self.fixed_color = list(getattr(module_data, 'fixed_color', []))
        #extra natal frame for topocentric primary directions
        #(openastromod.primary): ecliptic latitudes, RAMC and birth JD
        self.planets_latitude = list(getattr(module_data, 'planets_latitude', [0.0] * len(self.planets_degree_ut)))
        self.ramc = float(getattr(module_data, 'ramc', 0.0)) % 360.0
        self.birth_jd = float(getattr(module_data, 'jd_ut', 0.0))
        #dodecatemorias (Morinus antiscia.calcDodecatemoria):
        #se recalculan sobre las longitudes finales para que el
        #modo Composite (promedio de longitudes) tambien sea correcto
        self.planets_dodecatemoria_ut = [ephemeris.calc_dodecatemoria(v) for v in self.planets_degree_ut]
        self.planets_dodecatemoria_sign = [int(v // 30.0) % 12 for v in self.planets_dodecatemoria_ut]
        self.planets_dodecatemoria = [v - s * 30.0 for v, s in zip(self.planets_dodecatemoria_ut, self.planets_dodecatemoria_sign)]
        self.houses_dodecatemoria_ut = [ephemeris.calc_dodecatemoria(v) for v in self.houses_degree_ut]
        self.houses_dodecatemoria_sign = [int(v // 30.0) % 12 for v in self.houses_dodecatemoria_ut]
        self.houses_dodecatemoria = [v - s * 30.0 for v, s in zip(self.houses_dodecatemoria_ut, self.houses_dodecatemoria_sign)]

        if self.type == "Dodecatemoria":
            #rueda simple de dodecatemorias: los planetas se dibujan en sus
            #dodecatemorias sobre el marco de casas natales (los atributos
            #planets_dodecatemoria_* ya contienen estos mismos valores)
            self.planets_degree_ut = list(self.planets_dodecatemoria_ut)
            self.planets_sign = list(self.planets_dodecatemoria_sign)
            self.planets_degree = list(self.planets_dodecatemoria)

        if self.type == "Transit" and getattr(self, 'solar_active', False) and getattr(self, 'biwheel_single', '') == "Dodecatemoria":
            #bi-rueda de dodecatemorias: la rama Transit reescribe t_* desde
            #t_year (= natal), asi que la rueda exterior se re-deriva aqui
            #como dodecatemorias del radix (interior intacto)
            self.t_planets_degree_ut = list(self.planets_dodecatemoria_ut)
            self.t_planets_sign = list(self.planets_dodecatemoria_sign)
            self.t_planets_degree = list(self.planets_dodecatemoria)
            self.t_planets_retrograde = list(self.planets_retrograde)
            self.t_houses_degree_ut = list(self.houses_dodecatemoria_ut)
            self.t_houses_sign = list(self.houses_dodecatemoria_sign)
            self.t_houses_degree = list(self.houses_dodecatemoria)

        if self.type == "Directed":
            #rueda simple de direcciones primarias (vista "Outer only").
            #Ascensional: OA dirigidas sobre marco OA; eclipticas: Marr
            #sobre casas natales (ver localToDirected).
            arc = getattr(self, 'directed_arc', 0.0)
            measure = getattr(self, 'directed_measure', 'ecl_ecl')
            if measure == "asc_asc":
                oa_nat, dp, f_nat, dh = primary_engine.oa_positions(self.planets_degree_ut, self.planets_latitude, self.houses_degree_ut[0], arc, self.geolat, self.ramc, self.birth_jd)
            else:
                dp, dh = primary_engine.direct_frame(self.planets_degree_ut, self.planets_latitude, self.houses_degree_ut, arc, self.geolat, self.ramc, self.birth_jd)
            self.planets_degree_ut = dp
            self.planets_sign, self.planets_degree = self.split_sign_degree(dp)
            self.houses_degree_ut = dh
            self.houses_sign, self.houses_degree = self.split_sign_degree(dh)

        if self.type == "Transit" and getattr(self, 'solar_active', False) and getattr(self, 'biwheel_single', '') == "Directed":
            #bi-rueda de direcciones primarias: la rama Transit reescribe t_*
            #desde t_year, asi que la rueda exterior se re-deriva aqui
            #(interior intacto, salvo ascensional que renderiza ambas en OA).
            arc = getattr(self, 'directed_arc', 0.0)
            measure = getattr(self, 'directed_measure', 'ecl_ecl')
            if measure == "asc_asc":
                oa_nat, dp, f_nat, dh = primary_engine.oa_positions(self.planets_degree_ut, self.planets_latitude, self.houses_degree_ut[0], arc, self.geolat, self.ramc, self.birth_jd)
                self.planets_degree_ut = oa_nat
                self.planets_sign, self.planets_degree = self.split_sign_degree(oa_nat)
                self.houses_degree_ut = f_nat
                self.houses_sign, self.houses_degree = self.split_sign_degree(f_nat)
            else:
                dp, dh = primary_engine.direct_frame(self.planets_degree_ut, self.planets_latitude, self.houses_degree_ut, arc, self.geolat, self.ramc, self.birth_jd)
            self.t_planets_degree_ut = dp
            self.t_planets_sign, self.t_planets_degree = self.split_sign_degree(dp)
            self.t_planets_retrograde = list(self.planets_retrograde)
            self.t_houses_degree_ut = dh
            self.t_houses_sign, self.t_houses_degree = self.split_sign_degree(dh)
        
        #make composite averages
        if self.type == "Composite":
            #new houses
            asc = self.houses_degree_ut[0]
            t_asc = self.t_houses_degree_ut[0]
            for i in range(12):
                #difference in distances measured from ASC
                diff = self.houses_degree_ut[i] - asc
                if diff < 0:
                    diff = diff + 360.0
                t_diff = self.t_houses_degree_ut[i] - t_asc
                if t_diff < 0:
                    t_diff = t_diff + 360.0 
                newdiff = (diff + t_diff) / 2.0
                
                #new ascendant
                if asc > t_asc:
                    diff = asc - t_asc
                    if diff > 180:
                        diff = 360.0 - diff
                        nasc = asc + (diff / 2.0)
                    else:
                        nasc = t_asc + (diff / 2.0)
                else:
                    diff = t_asc - asc
                    if diff > 180:
                        diff = 360.0 - diff
                        nasc = t_asc + (diff / 2.0)
                    else:
                        nasc = asc + (diff / 2.0)
                
                #new house degrees
                self.houses_degree_ut[i] = nasc + newdiff
                if self.houses_degree_ut[i] > 360:
                    self.houses_degree_ut[i] = self.houses_degree_ut[i] - 360.0 
                    
                #new house sign             
                for x in range(len(self.zodiac)):
                    deg_low=float(x*30)
                    deg_high=float((x+1)*30)
                    if self.houses_degree_ut[i] >= deg_low:
                        if self.houses_degree_ut[i] <= deg_high:
                            self.houses_sign[i]=x
                            self.houses_degree[i] = self.houses_degree_ut[i] - deg_low

            #new planets
            for i in range(23):
                #difference in degrees
                p1 = self.planets_degree_ut[i]
                p2 = self.t_planets_degree_ut[i]
                if p1 > p2:
                    diff = p1 - p2
                    if diff > 180:
                        diff = 360.0 - diff
                        self.planets_degree_ut[i] = (diff / 2.0) + p1
                    else:
                        self.planets_degree_ut[i] = (diff / 2.0) + p2
                else:
                    diff = p2 - p1
                    if diff > 180:
                        diff = 360.0 - diff
                        self.planets_degree_ut[i] = (diff / 2.0) + p2
                    else:
                        self.planets_degree_ut[i] = (diff / 2.0) + p1
                
                if self.planets_degree_ut[i] > 360:
                    self.planets_degree_ut[i] = self.planets_degree_ut[i] - 360.0
            
            #list index 23 is asc, 24 is Mc, 25 is Dsc, 26 is Ic
            self.planets_degree_ut[23] = self.houses_degree_ut[0]
            self.planets_degree_ut[24] = self.houses_degree_ut[9]
            self.planets_degree_ut[25] = self.houses_degree_ut[6]
            self.planets_degree_ut[26] = self.houses_degree_ut[3]
                                
            #new planet signs
            for i in range(27):
                for x in range(len(self.zodiac)):
                    deg_low=float(x*30)
                    deg_high=float((x+1)*30)
                    if self.planets_degree_ut[i] >= deg_low:
                        if self.planets_degree_ut[i] <= deg_high:
                            self.planets_sign[i]=x
                            self.planets_degree[i] = self.planets_degree_ut[i] - deg_low
                            self.planets_retrograde[i] = False

        #antiscia y contraantiscia (Morinus antiscia.calc): se recalculan
        #sobre las longitudes finales para que el modo Composite tambien
        #sea correcto (los antiscios son tropicales por definicion)
        self.ayanamsa = float(getattr(module_data, 'ayanamsa', 0.0))
        ant = [ephemeris.calc_antiscion(v, self.ayanamsa) for v in self.planets_degree_ut]
        self.planets_antiscia_ut = [a for a, c in ant]
        self.planets_contra_ut = [c for a, c in ant]
        anth = [ephemeris.calc_antiscion(v, self.ayanamsa) for v in self.houses_degree_ut]
        self.houses_antiscia_ut = [a for a, c in anth]
        self.houses_contra_ut = [c for a, c in anth]

        if self.type == "Antiscia":
            #rueda simple de antiscios (o contraantiscios segun lo elegido):
            #los planetas se dibujan en esas posiciones sobre el marco de
            #casas natales
            contra = bool(getattr(self, 'antiscia_contra', False))
            outer = list(self.planets_contra_ut) if contra else list(self.planets_antiscia_ut)
            self.planets_degree_ut = outer
            self.planets_sign = [int(v // 30.0) % 12 for v in self.planets_degree_ut]
            self.planets_degree = [v - s * 30.0 for v, s in zip(self.planets_degree_ut, self.planets_sign)]

        if self.type == "Transit" and getattr(self, 'solar_active', False) and getattr(self, 'biwheel_single', '') == "Antiscia":
            #bi-rueda de antiscios (o contraantiscios): la rama Transit
            #reescribe t_* desde t_year (= natal), asi que la rueda exterior
            #se re-deriva aqui (interior intacto)
            contra = bool(getattr(self, 'antiscia_contra', False))
            outer = list(self.planets_contra_ut) if contra else list(self.planets_antiscia_ut)
            outer_houses = list(self.houses_contra_ut) if contra else list(self.houses_antiscia_ut)
            self.t_planets_degree_ut = outer
            self.t_planets_sign = [int(v // 30.0) % 12 for v in self.t_planets_degree_ut]
            self.t_planets_degree = [v - s * 30.0 for v, s in zip(self.t_planets_degree_ut, self.t_planets_sign)]
            self.t_planets_retrograde = list(self.planets_retrograde)
            self.t_houses_degree_ut = outer_houses
            self.t_houses_sign = [int(v // 30.0) % 12 for v in self.t_houses_degree_ut]
            self.t_houses_degree = [v - s * 30.0 for v, s in zip(self.t_houses_degree_ut, self.t_houses_sign)]
            
        
        #width and height from screen
        ratio = float(self.screen_width) / float(self.screen_height)
        if ratio < 1.3: #1280x1024
            wm_off = 130
        else: # 1024x768, 800x600, 1280x800, 1680x1050
            wm_off = 100
            
        #check for printer
        if printing == None:
            svgHeight=self.screen_height-wm_off
            svgWidth=self.screen_width-5.0
            #the drawing lives in a 772.2x546 viewBox with preserveAspectRatio,
            #so a screen shaped box just letterboxes it: keep its own ratio
            vb_ratio = 772.2/546.0
            if svgWidth/svgHeight > vb_ratio:
                svgWidth = svgHeight*vb_ratio
            else:
                svgHeight = svgWidth/vb_ratio
            #svgHeight=self.screen_height-wm_off
            #svgWidth=(770.0*svgHeight)/540.0
            #svgWidth=float(self.screen_width)-25.0
            rotate = "0"
            translate = "0"
            viewbox = '0 0 772.2 546.0' #297mm * 2.6 + 210mm * 2.6
        else:
            sizeX=546.0
            sizeY=772.2
            svgWidth = printing['width']
            svgHeight = printing['height']
            rotate = "0"
            viewbox = '0 0 772.2 546.0'
            translate = "0"
            
        
        #template dictionary        
        td = dict()
        r=240
        if(db.astrocfg['chartview']=="european"):
            self.c1=56
            self.c2=92
            self.c3=112
        else:               
            self.c1=0
            self.c2=36
            self.c3=120
        
        #transit
        if self.type == "Transit":
            td['transitRing']=self.transitRing( r )
            td['degreeRing']=self.degreeTransitRing( r )
            #circles
            td['c1'] = 'cx="' + str(r) + '" cy="' + str(r) + '" r="' + str(r-36) + '"'
            td['c1style'] = 'fill: none; stroke: %s; stroke-width: 1px; stroke-opacity:.4;'%(self.colors['zodiac_transit_ring_2'])
            td['c2'] = 'cx="' + str(r) + '" cy="' + str(r) + '" r="' + str(r-72) + '"'
            td['c2style'] = 'fill: %s; fill-opacity:.4; stroke: %s; stroke-opacity:.4; stroke-width: 1px'%(self.colors['paper_1'],self.colors['zodiac_transit_ring_1'])
            td['c3'] = 'cx="' + str(r) + '" cy="' + str(r) + '" r="' + str(r-160) + '"'
            td['c3style'] = 'fill: %s; fill-opacity:.8; stroke: %s; stroke-width: 1px'%(self.colors['paper_1'],self.colors['zodiac_transit_ring_0'])
            td['makeAspects'] = self.makeAspectsTransit( r , (r-160))
            td['makeAspectGrid'] = self.makeAspectTransitGrid( r )
            td['makeFixedStars'] = self.makeFixedStars( r )
            td['makePatterns'] = ''
        else:
            td['transitRing']=""
            td['degreeRing']=self.degreeRing( r )
            #circles
            td['c1'] = 'cx="' + str(r) + '" cy="' + str(r) + '" r="' + str(r-self.c1) + '"'
            td['c1style'] = 'fill: none; stroke: %s; stroke-width: 1px; '%(self.colors['zodiac_radix_ring_2'])
            td['c2'] = 'cx="' + str(r) + '" cy="' + str(r) + '" r="' + str(r-self.c2) + '"'
            td['c2style'] = 'fill: %s; fill-opacity:.2; stroke: %s; stroke-opacity:.4; stroke-width: 1px'%(self.colors['paper_1'],self.colors['zodiac_radix_ring_1'])
            td['c3'] = 'cx="' + str(r) + '" cy="' + str(r) + '" r="' + str(r-self.c3) + '"'
            td['c3style'] = 'fill: %s; fill-opacity:.8; stroke: %s; stroke-width: 1px'%(self.colors['paper_1'],self.colors['zodiac_radix_ring_0'])
            td['makeAspects'] = self.makeAspects( r , (r-self.c3))
            td['makeAspectGrid'] = self.makeAspectGrid( r )
            td['makeFixedStars'] = self.makeFixedStars( r )
            td['makePatterns'] = self.makePatterns()

        td['circleX']=str(0)
        td['circleY']=str(0)
        td['svgWidth']=str(svgWidth)
        td['svgHeight']=str(svgHeight)
        td['viewbox']=viewbox
        td['stringTitle']=self.name
        td['stringName']=self.charttype
        
        #bottom left
        siderealmode_chartview={
                "FAGAN_BRADLEY":_("Fagan Bradley"),
                "LAHIRI":_("Lahiri"),
                "DELUCE":_("Deluce"),
                "RAMAN":_("Ramanb"),
                "USHASHASHI":_("Ushashashi"),
                "KRISHNAMURTI":_("Krishnamurti"),
                "DJWHAL_KHUL":_("Djwhal Khul"),
                "YUKTESHWAR":_("Yukteshwar"),
                "JN_BHASIN":_("Jn Bhasin"),
                "BABYL_KUGLER1":_("Babyl Kugler 1"),
                "BABYL_KUGLER2":_("Babyl Kugler 2"),
                "BABYL_KUGLER3":_("Babyl Kugler 3"),
                "BABYL_HUBER":_("Babyl Huber"),
                "BABYL_ETPSC":_("Babyl Etpsc"),

    def tableFixedStars(self, widget, printing=None):
        #Fixed stars (Morinus fixstars.py): only stars in conjunction
        #(orb 1 degree) with a visible planet or a cusp are listed:
        #star | longitude | latitude | conjunction.
        self.tabletype="fixedstars"

        def fmt_lon(lon_ut):
            lon = float(lon_ut) % 360.0
            sign = int(lon // 30.0) % 12
            in_sign = lon - int(lon // 30.0) * 30.0
            d = int(in_sign)
            m = int((in_sign - d) * 60.0)
            s = int(round((((in_sign - d) * 60.0) - m) * 60.0))
            if s == 60:
                s = 0
                m += 1
            if m == 60:
                m = 0
                d += 1
                if d == 30:
                    d = 0
                    sign = (sign + 1) % 12
            return "%02d\xb0%02d'%02d\" %s" % (d, m, s, openAstro.zodiac_short[sign])

        def fmt_lat(lat):
            sign = '+' if lat >= 0 else '-'
            a = abs(float(lat))
            d = int(a)
            m = int(round((a - d) * 60.0))
            if m == 60:
                m = 0
                d += 1
            return "%s%02d\xb0%02d'" % (sign, d, m)

        rows = []
        for e in range(len(getattr(openAstro, 'fixed_names', []))):
            lon = openAstro.fixed_degree_ut[e]
            best, bestdiff = openAstro.fixed_star_hit(e)
            if best is None:
                continue
            dd = int(bestdiff)
            mm = int(round((bestdiff - dd) * 60.0))
            conj = "%s %02d\xb0%02d'" % (best, dd, mm)
            rows.append((lon % 360.0, openAstro.fixed_names[e], fmt_lon(lon),
                fmt_lat(openAstro.fixed_latitude[e]), conj))
        #zodiac order, Aries to Pisces
        rows.sort(key=lambda r: r[0])

        out = '<g transform="scale(1.1)">'
        x0, y0 = 40, 110
        col_star, col_lon, col_lat, col_conj = x0, x0 + 170, x0 + 340, x0 + 450
        row_h = 22
        textstyle = "font-size: 13px; fill: %s" % (openAstro.colors['paper_0'],)
        headerstyle = "font-size: 14px; font-weight: bold; fill: %s" % (openAstro.colors['paper_0'],)
        gridstyle = 'stroke:%s; stroke-width: 1px; stroke-opacity:.6; fill:none' % (openAstro.colors['paper_0'],)
        out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_star, y0, headerstyle, _('Star'))
        out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_lon, y0, headerstyle, _('Longitude'))
        out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_lat, y0, headerstyle, _('Latitude'))
        out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_conj, y0, headerstyle, _('Conjunction'))
        y = y0 + 10
        for (lon_ut, label, slon, slat, sconj) in rows:
            y += row_h
            out += '<rect x="%s" y="%s" width="640" height="%s" style="%s"/>\n' % (x0 - 25, y - 16, row_h, gridstyle)
            out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_star, y, textstyle, label)
            out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_lon, y, textstyle, slon)
            out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_lat, y, textstyle, slat)
            out += '<text x="%s" y="%s" style="%s">%s</text>\n' % (col_conj, y, textstyle, sconj)
        out += "</g>"

        td = {}
        td['paper_color_0']=openAstro.colors["paper_0"]
        td['paper_color_1']=openAstro.colors["paper_1"]
        for i in range(len(openAstro.planets)):
            td['planets_color_%s'%(i)]=openAstro.colors["planet_%s"%(i)]
        for i in range(12):
            td['zodiac_color_%s'%(i)]=openAstro.colors["zodiac_icon_%s" %(i)]
        for i in range(len(openAstro.aspects)):
            td['orb_color_%s'%(openAstro.aspects[i]['degree'])]=openAstro.colors["aspect_%s" %(openAstro.aspects[i]['degree'])]
        td['stringTitle'] = "Fixed Stars for %s"%(openAstro.name)

        pages=1
        pagesY = (1188 * pages)+10
        if printing:
            td['svgWidth'] = printing['width']
            td['svgHeight'] = printing['height']
            td['viewbox'] = "0 %s 840 1188" %( printing['pagenum']*(1188+10) )
        else:
            td['svgWidth'] = 1050
            td['svgHeight'] = (td['svgWidth']/840.0)* pagesY
            td['viewbox'] = "0 0 840 %s" %( pagesY )

        td['data'] = out
        td['pagesRect'] = '<rect x="0" y="0" width="840" height="1188" style="fill: %s;" />' % (openAstro.colors['paper_1'],)

        f=open(cfg.xml_svg_table)
        template=Template(f.read()).substitute(td)
        f.close()
        if printing:
            f=open(cfg.tempfilenametableprint,"w")
        else:
            f=open(cfg.tempfilenametable,"w")
        f.write(template)
        f.close()

